{
  "ConnectionStrings": {
    "Shavit": "Server=127.0.0.1;Port=3306;Database=shavit;User=readonly;Password=CHANGE_ME;SslMode=None"
  },
  "SurfWeb": {
    "Database": {
      "Provider": "MySql"
    },
    "CorsOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ],
    "MinResponseDelaySeconds": 0.5,
    "Cache": {
      "MapsMinutes": 5,
      "LeaderboardSeconds": 60,
      "RankingsRefreshMinutes": 1,
      "RecentRefreshMinutes": 1,
      "RecentPushSeconds": 30
    },
    "Styles": [
      { "Id": 0, "Name": "Default", "Default": true }
    ],
    "MapImages": {
      "BaseUrl": "https://example.com/surf-map-images/",
      "Extension": ".jpg"
    },
    "ServerQuery": {
      "RefreshSeconds": 30,
      "QueryTimeoutMs": 8000
    },
    "ExternalApi": {
      "LatestRecordsToken": "123456"
    },
    "Servers": [
      {
        "Name": "Example Surf Server",
        "Address": "connect 127.0.0.1:27015",
        "Host": "127.0.0.1",
        "Port": 27015,
        "MaxPlayers": 64
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
