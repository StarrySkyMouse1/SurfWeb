# 复制为 Build/.env：Copy-Item env.example .env（在 Build 目录下）
# Docker 与宿主机模式共用；执行 .\Build\surf.ps1 可引导创建

# prebuilt | full（仅 docker compose 使用）
SURFWEB_BUILD_MODE=prebuilt

# Docker 基础镜像（默认 DaoCloud 加速，不走 Docker Hub）
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# full 模式容器内 npm 构建时使用
NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# 海外或自有代理可改回 Hub：nginx:1.27-alpine / node:22-alpine

# 数据库类型（建议只读库）：MySql（默认）| Sqlite
DATABASE_PROVIDER=MySql

# MySql：Shavit 只读库连接串
SHAVIT_CONNECTION_STRING=Server=YOUR_DB_HOST;Port=3306;Database=shavit;User=readonly;Password=CHANGE_ME;SslMode=None;CharSet=utf8mb4

# Sqlite 示例（需自备与 Shavit 同结构的 .db 文件）
# DATABASE_PROVIDER=Sqlite
# SHAVIT_CONNECTION_STRING=Data Source=./data/shavit.db

# api访问token
LATEST_RECORDS_TOKEN=
WEB_PORT=8080
VITE_SITE_TITLE=地满滑翔
# 页脚「网站运维」署名；留空则不显示该行
VITE_SITE_OPS=

MAP_IMAGES_BASE_URL=https://example.com/surf-map-images/
MAP_IMAGES_EXTENSION=.jpg

# Docker 容器访问宿主机游戏服可用 host.docker.internal；宿主机模式改为真实 IP/域名
SURF_SERVER_NAME=Your Surf Server
SURF_SERVER_ADDRESS=connect host.docker.internal:27015
SURF_SERVER_HOST=host.docker.internal
SURF_SERVER_PORT=27015
SURF_SERVER_MAX_PLAYERS=64
