# 模式 A（构建发布）：复制为 .env.production 后执行 npm run build
# Docker 模式不需要此文件（见 Web/Dockerfile 中的 VITE_API_BASE_URL）

# 与宿主机 Nginx 同域反代 /api 时（推荐，见 deploy/nginx-host.example.conf）
VITE_API_BASE_URL=/api/v1
VITE_SITE_TITLE=地满滑翔

# 前后端不同域时改为完整 API 根路径，并在后端配置 SurfWeb:CorsOrigins
# VITE_API_BASE_URL=https://api.example.com/api/v1
