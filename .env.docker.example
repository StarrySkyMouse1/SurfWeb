# 复制为仓库根目录 .env 后修改，再执行：docker compose up -d --build

# 必填：Shavit 只读库（容器内需能访问数据库地址，勿用 127.0.0.1 指宿主机上的库，除非用 host 网络）
SHAVIT_CONNECTION_STRING=Server=YOUR_DB_HOST;Port=3306;Database=shavit;User=readonly;Password=CHANGE_ME;SslMode=None;CharSet=utf8mb4

# 对外最新记录 API token（留空则该接口一律 401）
LATEST_RECORDS_TOKEN=

# 站点对外端口（浏览器访问 http://localhost:8080）
WEB_PORT=8080

# 前端站点名（顶栏、页脚、浏览器标题）
VITE_SITE_TITLE=地满滑翔

# 地图图床
MAP_IMAGES_BASE_URL=https://example.com/surf-map-images/
MAP_IMAGES_EXTENSION=.jpg

# 游戏服 A2S 查询（容器内访问宿主机游戏服可用 host.docker.internal）
SURF_SERVER_NAME=Your Surf Server
SURF_SERVER_ADDRESS=connect host.docker.internal:27015
SURF_SERVER_HOST=host.docker.internal
SURF_SERVER_PORT=27015
SURF_SERVER_MAX_PLAYERS=64
